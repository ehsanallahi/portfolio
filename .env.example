# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical URL used for metadata, sitemap and robots.txt.
# Optional on Vercel (the production URL is detected automatically) —
# set it when you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (https://resend.com) — server-only, never exposed to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=ehsanallahi47@gmail.com
# Sender. Must be on a domain verified in Resend. Without a verified domain,
# Resend's test sender only delivers to your own Resend account email.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
